# Путь к базе данных SQLite
DATABASE_URL="file:./dev.db"

# Пароль для входа в админ-панель (/login)
ADMIN_PASSWORD=

# Секрет сессии — сгенерируйте свою случайную строку для продакшена,
# например: openssl rand -hex 32
AUTH_SECRET=

# Уведомления о новых заявках в Telegram (необязательно).
# Токен — от @BotFather, chat id — личный или групповой чат, куда слать.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет вебхука для кнопок статусов (случайная строка, например:
# openssl rand -hex 32). Тот же секрет передаётся в setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# Адрес сайта — добавляется ссылкой на заявки в сообщение
SITE_URL=https://mkm-01.ru
