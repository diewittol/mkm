// Prisma schema для МКМ

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Категории мебели
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  image       String?
  description String?
  order       Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Изделия
model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  categoryId       String
  shortDescription String?
  description      String?

  seoTitle       String?
  seoDescription String?

  isPublished Boolean @default(false)

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  specifications ProductSpecification[]
  applications   Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// Фотографии изделия
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Характеристики изделия
model ProductSpecification {
  id        String @id @default(cuid())
  productId String
  name      String
  value     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Заявки с сайта
model Application {
  id      String  @id @default(cuid())
  name    String
  phone   String
  message String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  status String @default("new") // new | in_progress | done | rejected

  // Кто и когда последним менял статус (имя из Telegram или «админка»)
  handledBy String?
  handledAt DateTime?

  // Откуда заявка: site — форма на сайте, manual — добавлена вручную (сарафан и т.п.)
  source String @default("site")

  // Стоимость заказа в рублях (целое число); вписывает админ, клиенту не показывается
  price Int?

  notes    ApplicationNote[]
  expenses ApplicationExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Настройки сайта (singleton)
model Settings {
  id          String  @id @default("singleton")
  companyName String
  phone       String
  email       String
  address     String
  telegram    String?
  whatsapp    String?

  updatedAt DateTime @updatedAt
}


// Реализованные проекты
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  location    String?

  isPublished Boolean  @default(false)
  order       Int      @default(0)

  images ProjectImage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Фотографии проекта
model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  alt       String?
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
// Люди с доступом к Telegram-боту (владелец задаётся в .env и здесь не хранится)
model TelegramUser {
  id        String   @id @default(cuid())
  chatId    String   @unique // Telegram user id (в личном чате совпадает с chat id)
  name      String
  role      String   @default("manager")
  createdAt DateTime @default(now())
}

// Разовые приглашения в бота
model TelegramInvite {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Черновик заявки, которую добавляют вручную через бота (диалог из двух шагов)
model TelegramDraft {
  id        String   @id @default(cuid())
  chatId    String   @unique
  step      String   // await — ждём текст, confirm — ждём подтверждения
  name      String?
  phone     String?
  message   String?
  // Режим «заметки»: к какой заявке сейчас добавляются заметки и фото
  applicationId String?
  // Идентификатор текущего сеанса заметок: всё присланное за сеанс — одна заметка
  noteBatch     String?
  // Режим «расход»: какой вид расхода ждём следующим сообщением (material | ready)
  expenseKind   String?
  updatedAt DateTime @updatedAt
}

// Адреса магазинов (показываются на странице контактов, в футере и на карте)
model Location {
  id        String   @id @default(cuid())
  title     String   // «Магазин на Верещагина»
  address   String
  hours     String?  // «Пн–Пт, 9:00–18:00»
  lat       Float?
  lon       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Лента заметок и фото внутри заявки (замеры, пожелания, эскизы).
// Фото хранятся в закрытой папке, не в public/.
model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  author        String   // @username, имя из Telegram или «админка»
  text          String?
  photo         String?  // имя файла в private-uploads/orders
  audio         String?  // голосовое (ogg/mp3/m4a), там же
  audioSeconds  Int?     // длительность, если известна
  // Записи одного сеанса добавления (текст + фото + голосовые) показываются
  // как одна заметка. У старых записей пусто — каждая сама по себе.
  batchId       String?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Расход на заказ: закупка материала. kind — material (материал, который
// обрабатываем сами, идёт в наценку) или ready (готовое изделие/деталь без
// наценки: столешница, готовый фасад). Можно добавлять сколько угодно раз,
// суммы складываются.
model ApplicationExpense {
  id            String   @id @default(cuid())
  applicationId String
  kind          String // material | ready
  amount        Int // рубли
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Пароль админки, заданный через бота (singleton). Хранится только хэш.
// Если записи нет, работает ADMIN_PASSWORD из .env; если есть — только она.
model AdminCredential {
  id           String   @id @default("singleton")
  passwordHash String
  changedBy    String?
  updatedAt    DateTime @updatedAt
}
